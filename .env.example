# Copy this file to .env and fill in your key. Never commit .env.
CRYPTORANK_API_KEY=
# Optional: CryptoRank v3 base URL (defaults to https://api.cryptorank.io/v3)
API_V3_URL=

# Supabase (Dashboard → Project Settings → API). The secret key is server-only:
# never give it a VITE_ prefix and never ship it to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
RESTful_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Wallet import (US-6.4): free Etherscan key, set as a wallet-lookup function setting only.
ETHERSCAN_API_KEY=
